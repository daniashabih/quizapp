{
  "buildCommand": "prisma generate && node scripts/generateSitemap.js && vite build && node scripts/generateSitemap.js",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/.prisma/client/**,node_modules/@prisma/client/**,prisma/**}"
    }
  },
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/account-deletion",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/data-deletion",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/quizzes",
      "destination": "/technologies",
      "permanent": true
    },
    {
      "source": "/quiz",
      "destination": "/technologies",
      "permanent": true
    },
    {
      "source": "/technologies/level",
      "destination": "/technologies",
      "permanent": true
    },
    {
      "source": "/games/coding-memory-match",
      "destination": "/games/memory-match",
      "permanent": true
    },
    {
      "source": "/seo",
      "destination": "/dashboard/seo",
      "permanent": true
    },
    {
      "source": "/admin/seo",
      "destination": "/dashboard/seo",
      "permanent": true
    },
    {
      "source": "/certificates",
      "destination": "/dashboard/certificates",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/dashboard/profile",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/dashboard/settings",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(favicon-32x32\\.png|favicon-48x48\\.png|favicon\\.png|apple-touch-icon\\.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/branding/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|branding/|favicon|apple-touch-icon|robots\\.txt|sitemap\\.xml|ads\\.txt|app-ads\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
