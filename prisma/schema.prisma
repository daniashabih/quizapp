generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String       @unique
  password         String
  avatar           String?      @default("")
  role             String       @default("user")
  isVerified       Boolean      @default(false) @map("is_verified")
  resetToken       String?      @map("reset_token")
  resetTokenExpiry DateTime?    @map("reset_token_expiry")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime?    @updatedAt @map("updated_at")
  results          QuizResult[]

  @@map("users")
}

model Question {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  session       Int?     @default(1)
  questionText  String   @map("question_text")
  options       String
  correctAnswer String   @map("correct_answer")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("questions")
}

model QuizResult {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @map("user_id") @db.ObjectId
  category   String
  session    Int?     @default(1)
  score      Int
  total      Int
  percentage Float
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  isEnabled Boolean? @default(true) @map("is_enabled")

  @@map("categories")
}

model QuizAttempt {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String    @map("user_id")
  category             String
  session              Int?      @default(1)
  currentQuestionIndex Int       @default(0) @map("current_question_index")
  answers              String    @default("{}")
  flaggedQuestions     String    @default("[]") @map("flagged_questions")
  questionsSnapshot    String    @map("questions_snapshot")
  score                Int       @default(0)
  totalQuestions       Int       @default(0) @map("total_questions")
  answeredCount        Int       @default(0) @map("answered_count")
  progressPercentage   Float     @default(0) @map("progress_percentage")
  status               String    @default("in_progress")
  startedAt            DateTime  @default(now()) @map("started_at")
  lastSavedAt          DateTime  @default(now()) @map("last_saved_at")
  completedAt          DateTime? @map("completed_at")

  @@index([userId, status])
  @@index([userId, category, session, status])
  @@map("quiz_attempts")
}

model Setting {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  appName                 String   @default("HangBug") @map("app_name")
  passingScore            Int      @default(70) @map("passing_score")
  certificatePassingScore Int      @default(80) @map("certificate_passing_score")
  quizTimerEnabled        Boolean  @default(false) @map("quiz_timer_enabled")
  quizTimerSeconds        Int      @default(30) @map("quiz_timer_seconds")
  adsEnabled              Boolean  @default(true) @map("ads_enabled")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage      String   @default("HangBug is undergoing scheduled maintenance. We'll be back shortly!") @map("maintenance_message")
  certificateEnabled      Boolean  @default(true) @map("certificate_enabled")
  leaderboardEnabled      Boolean  @default(true) @map("leaderboard_enabled")
  primaryColor            String   @default("#193D35") @map("primary_color")
  secondaryColor          String   @default("#FFFFFF") @map("secondary_color")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}
