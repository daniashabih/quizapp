generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String       @unique
  password          String
  avatar            String?      @default("")
  role              String       @default("user")
  isVerified        Boolean      @default(false) @map("is_verified")
  googleId          String?      @map("google_id")
  resetToken        String?      @map("reset_token")
  resetTokenExpiry  DateTime?    @map("reset_token_expiry")
  passwordChangedAt DateTime?    @map("password_changed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime?    @updatedAt @map("updated_at")
  results           QuizResult[]
  gameScores        GameScore[]

  @@map("users")
}

model Question {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  session       Int?     @default(1)
  questionText  String   @map("question_text")
  options       String
  correctAnswer String   @map("correct_answer")
  explanation   String?  @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("questions")
}

model QuizResult {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @map("user_id") @db.ObjectId
  category   String
  session    Int?     @default(1)
  score      Int
  total      Int
  percentage Float
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  isEnabled Boolean? @default(true) @map("is_enabled")

  @@map("categories")
}

model QuizAttempt {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String    @map("user_id")
  category             String
  session              Int?      @default(1)
  currentQuestionIndex Int       @default(0) @map("current_question_index")
  answers              String    @default("{}")
  flaggedQuestions     String    @default("[]") @map("flagged_questions")
  questionsSnapshot    String    @map("questions_snapshot")
  score                Int       @default(0)
  totalQuestions       Int       @default(0) @map("total_questions")
  answeredCount        Int       @default(0) @map("answered_count")
  progressPercentage   Float     @default(0) @map("progress_percentage")
  status               String    @default("in_progress")
  startedAt            DateTime  @default(now()) @map("started_at")
  lastSavedAt          DateTime  @default(now()) @map("last_saved_at")
  completedAt          DateTime? @map("completed_at")

  @@index([userId, status])
  @@index([userId, category, session, status])
  @@map("quiz_attempts")
}

model Setting {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  appName                 String   @default("HangBug") @map("app_name")
  passingScore            Int      @default(70) @map("passing_score")
  certificatePassingScore Int      @default(80) @map("certificate_passing_score")
  quizTimerEnabled        Boolean  @default(false) @map("quiz_timer_enabled")
  quizTimerSeconds        Int      @default(30) @map("quiz_timer_seconds")
  adsEnabled              Boolean  @default(true) @map("ads_enabled")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage      String   @default("HangBug is undergoing scheduled maintenance. We'll be back shortly!") @map("maintenance_message")
  certificateEnabled      Boolean  @default(true) @map("certificate_enabled")
  leaderboardEnabled      Boolean  @default(true) @map("leaderboard_enabled")
  primaryColor            String   @default("#193D35") @map("primary_color")
  secondaryColor          String   @default("#FFFFFF") @map("secondary_color")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Game {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  slug         String             @unique
  title        String
  description  String
  instructions String?            @default("")
  category     String             // "Coding Games" or "Typing Games"
  difficulty   String?            @default("All Levels")
  thumbnail    String?            @default("")
  badge        String?            @default("") // "Featured", "Hot", "New", "Popular"
  isPublished  Boolean            @default(true) @map("is_published")
  isFeatured   Boolean            @default(false) @map("is_featured")
  cardSize     String?            @default("medium") @map("card_size") // "large", "tall", "medium", "small"
  aspectRatio  String?            @default("16/9") @map("aspect_ratio")
  order        Int                @default(0)
  playsCount   Int                @default(0) @map("plays_count")
  rating       Float?             @default(4.9)
  supportedTechnologies String[]  @default([]) @map("supported_technologies")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime?          @updatedAt @map("updated_at")
  scores       GameScore[]
  favorites    UserGameFavorite[]

  @@map("games")
}

model GameScore {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @map("user_id") @db.ObjectId
  gameId          String   @map("game_id") @db.ObjectId
  gameSlug        String   @map("game_slug")
  technology      String?  @default("all")
  technologyName  String?  @default("") @map("technology_name")
  score           Int
  highScore       Int?     @default(0) @map("high_score")
  accuracy        Float?   @default(100.0)
  wpm             Float?   @default(0.0)
  difficulty      String?  @default("All Levels")
  isCompleted     Boolean? @default(true) @map("is_completed")
  durationSeconds Int?     @default(0) @map("duration_seconds")
  metadata        String?  @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameSlug])
  @@index([gameSlug, score])
  @@index([userId, technology])
  @@map("game_scores")
}

model UserGameProgress {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id")
  gameSlug     String   @map("game_slug")
  highScore    Int      @default(0) @map("high_score")
  bestWpm      Float?   @default(0) @map("best_wpm")
  bestAccuracy Float?   @default(0) @map("best_accuracy")
  totalPlays   Int      @default(0) @map("total_plays")
  lastPlayedAt DateTime @default(now()) @map("last_played_at")

  @@unique([userId, gameSlug])
  @@map("user_game_progress")
}

model UserTechProgress {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id")
  technology   String   // e.g. "html", "javascript", "flutter"
  gameSlug     String   @default("overall") @map("game_slug")
  difficulty   String?  @default("All Levels")
  highScore    Int      @default(0) @map("high_score")
  bestWpm      Float?   @default(0) @map("best_wpm")
  bestAccuracy Float?   @default(0) @map("best_accuracy")
  totalPlays   Int      @default(0) @map("total_plays")
  lastPlayedAt DateTime @default(now()) @map("last_played_at")

  @@unique([userId, technology, gameSlug])
  @@index([userId, technology])
  @@map("user_tech_progress")
}

model UserGameFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id")
  gameId    String   @map("game_id") @db.ObjectId
  gameSlug  String   @map("game_slug")
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameSlug])
  @@map("user_game_favorites")
}

model GameTechCategory {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  name         String           @unique
  slug         String           @unique
  description  String?          @default("")
  icon         String?          @default("Layout")
  order        Int              @default(0)
  isEnabled    Boolean          @default(true) @map("is_enabled")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime?        @updatedAt @map("updated_at")
  technologies GameTechnology[]

  @@map("game_tech_categories")
}

model GameTechnology {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  categoryId     String           @map("category_id") @db.ObjectId
  categorySlug   String           @map("category_slug")
  name           String           @unique
  slug           String           @unique
  description    String?          @default("")
  icon           String?          @default("code")
  color          String?          @default("#10B981")
  badge          String?          @default("")
  supportedGames String[]         @default([]) @map("supported_games")
  isEnabled      Boolean          @default(true) @map("is_enabled")
  order          Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime?        @updatedAt @map("updated_at")

  category       GameTechCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categorySlug])
  @@map("game_technologies")
}

model GameChallenge {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  gameSlug       String   @map("game_slug")
  technology     String?  @default("general")
  technologyName String?  @default("") @map("technology_name")
  title          String
  difficulty     String   @default("Beginner") // Beginner, Intermediate, Advanced
  language       String?  @default("javascript") // html, css, javascript, php, python, sql, dart, flutter, etc.
  description    String?  @default("")
  content        String   // Code snippet, passage text, scrambled blocks, or puzzle spec (JSON or string)
  solution       String   // Expected answer, order, correct line, or expected SQL result (kept secure on backend)
  hints          String?  @default("")
  explanation    String?  @default("")
  points         Int?     @default(100)
  order          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([gameSlug, difficulty])
  @@index([gameSlug, technology, difficulty])
  @@map("game_challenges")
}

model BlogPost {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  slug                String   @unique
  title               String
  excerpt             String
  content             String
  category            String
  tags                String[] @default([])
  difficulty          String?  @default("All Levels")
  readingTimeMinutes  Int      @default(8) @map("reading_time_minutes")
  authorName          String   @default("HangBug Editorial Team") @map("author_name")
  authorRole          String?  @default("Senior Software Engineer & Technical Educator") @map("author_role")
  authorBio           String?  @default("") @map("author_bio")
  authorAvatar        String?  @default("") @map("author_avatar")
  coverGradient       String?  @default("gradient-emerald") @map("cover_gradient")
  coverImage          String?  @default("") @map("cover_image")
  seoTitle            String?  @default("") @map("seo_title")
  seoDescription      String?  @default("") @map("seo_description")
  seoKeywords         String[] @default([]) @map("seo_keywords")
  canonicalUrl        String?  @default("") @map("canonical_url")
  relatedQuizCategory String?  @default("") @map("related_quiz_category")
  relatedGameSlug     String?  @default("") @map("related_game_slug")
  keyTakeaways        String[] @default([]) @map("key_takeaways")
  isPublished         Boolean  @default(true) @map("is_published")
  isFeatured          Boolean  @default(false) @map("is_featured")
  viewsCount          Int      @default(0) @map("views_count")
  order               Int      @default(0)
  publishedAt         DateTime @default(now()) @map("published_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([category, isPublished])
  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model KnowledgeBook {
  id                   String                  @id @default(auto()) @map("_id") @db.ObjectId
  title                String
  author               String
  edition              String?                 @default("")
  description          String?                 @default("")
  publicationYear      Int?                    @map("publication_year")
  technology           String
  technologyNormalized String                  @map("technology_normalized")
  fileName             String                  @map("file_name")
  fileType             String                  @map("file_type")
  mimeType             String                  @map("mime_type")
  fileSize             Int                     @default(0) @map("file_size")
  fileHash             String                  @map("file_hash")
  storageMode          String                  @default("mongodb_parts") @map("storage_mode")
  totalParts           Int                     @default(0) @map("total_parts")
  isEnabled            Boolean                 @default(true) @map("is_enabled")
  processingStatus     String                  @default("Uploaded") @map("processing_status")
  processingProgress   Int                     @default(0) @map("processing_progress")
  processingError      String?                 @default("") @map("processing_error")
  ocrUsed              Boolean                 @default(false) @map("ocr_used")
  totalPages           Int                     @default(0) @map("total_pages")
  totalChunks          Int                     @default(0) @map("total_chunks")
  indexedChunks        Int                     @default(0) @map("indexed_chunks")
  embeddingModel       String?                 @default("") @map("embedding_model")
  embeddingDimensions  Int?                    @default(1536) @map("embedding_dimensions")
  knowledgeVersion     Int                     @default(1) @map("knowledge_version")
  uploadedBy           String?                 @default("") @map("uploaded_by")
  lastIndexedAt        DateTime?               @map("last_indexed_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  chunks               KnowledgeBookChunk[]
  fileParts            KnowledgeBookFilePart[]

  @@index([technologyNormalized, isEnabled])
  @@index([fileHash])
  @@index([processingStatus])
  @@map("knowledge_books")
}

model KnowledgeBookFilePart {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  bookId    String        @map("book_id") @db.ObjectId
  partIndex Int           @map("part_index")
  data      Bytes
  createdAt DateTime      @default(now()) @map("created_at")
  book      KnowledgeBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, partIndex])
  @@index([bookId])
  @@map("knowledge_book_file_parts")
}

model KnowledgeBookChunk {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  bookId               String        @map("bookId") @db.ObjectId
  technology           String        @map("technology")
  technologyNormalized String        @map("technologyNormalized")
  bookTitle            String        @map("bookTitle")
  author               String        @map("author")
  edition              String?       @default("") @map("edition")
  chapter              String?       @default("") @map("chapter")
  pageNumber           Int?          @default(1) @map("pageNumber")
  chunkIndex           Int           @default(0) @map("chunkIndex")
  chunkText            String        @map("chunkText")
  contentHash          String        @map("contentHash")
  embedding            Float[]       @map("embedding")
  isActive             Boolean       @default(true) @map("isActive")
  createdAt            DateTime      @default(now()) @map("createdAt")
  book                 KnowledgeBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([technologyNormalized, isActive])
  @@index([contentHash])
  @@map("knowledge_book_chunks")
}

model QuestionVerification {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  cacheKey              String    @unique @map("cache_key")
  questionId            String?   @default("") @map("question_id")
  technology            String
  technologyNormalized  String    @map("technology_normalized")
  questionText          String    @map("question_text")
  options               String
  originalCorrectAnswer String    @map("original_correct_answer")
  verifiedCorrectAnswer String?   @default("") @map("verified_correct_answer")
  verificationStatus    String    @map("verification_status")
  explanation           String
  sourceBook            String?   @default("") @map("source_book")
  sourceAuthor          String?   @default("") @map("source_author")
  sourceChapter         String?   @default("") @map("source_chapter")
  sourcePage            String?   @default("") @map("source_page")
  supportingExcerpt     String?   @default("") @map("supporting_excerpt")
  issueDescription      String?   @default("") @map("issue_description")
  suggestedCorrection   String?   @default("") @map("suggested_correction")
  confidence            Float     @default(0)
  knowledgeBaseVersion  String    @map("knowledge_base_version")
  retrievedChunkIds     String[]  @default([]) @map("retrieved_chunk_ids")
  reviewStatus          String    @default("pending") @map("review_status")
  reviewedBy            String?   @default("") @map("reviewed_by")
  reviewedAt            DateTime? @map("reviewed_at")
  reviewNotes           String?   @default("") @map("review_notes")
  requestCount          Int       @default(1) @map("request_count")
  lastRequestedAt       DateTime  @default(now()) @map("last_requested_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([technologyNormalized, verificationStatus])
  @@index([verificationStatus, reviewStatus])
  @@index([questionId])
  @@map("question_verifications")
}

model QuestionCorrectionHistory {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId            String   @map("question_id")
  verificationId        String   @map("verification_id")
  technology            String
  questionText          String   @map("question_text")
  previousCorrectAnswer String   @map("previous_correct_answer")
  newCorrectAnswer      String   @map("new_correct_answer")
  previousExplanation   String?  @default("") @map("previous_explanation")
  newExplanation        String?  @default("") @map("new_explanation")
  sourceBook            String?  @default("") @map("source_book")
  sourceChapter         String?  @default("") @map("source_chapter")
  sourcePage            String?  @default("") @map("source_page")
  approvedBy            String   @map("approved_by")
  approvedByEmail       String?  @default("") @map("approved_by_email")
  notes                 String?  @default("")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([questionId])
  @@index([createdAt])
  @@map("question_correction_history")
}

model SeoProjectConfig {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  domain                    String   @unique
  projectName               String   @default("Hangbug") @map("project_name")
  siteUrl                   String   @default("https://www.hangbug.com") @map("site_url")
  gscProperty               String?  @default("") @map("gsc_property")
  ga4PropertyId             String?  @default("") @map("ga4_property_id")
  ga4MeasurementId          String   @default("G-BSZBBFZZH0") @map("ga4_measurement_id")
  googleServiceAccountEmail String?  @default("") @map("google_service_account_email")
  googlePrivateKey          String?  @default("") @map("google_private_key")
  googleAccessToken         String?  @default("") @map("google_access_token")
  pagespeedApiKey           String?  @default("") @map("pagespeed_api_key")
  keywordProvider           String   @default("none") @map("keyword_provider")
  keywordProviderKey        String?  @default("") @map("keyword_provider_key")
  backlinkProvider          String   @default("none") @map("backlink_provider")
  backlinkProviderKey       String?  @default("") @map("backlink_provider_key")
  aiVisibilityProvider      String   @default("none") @map("ai_visibility_provider")
  aiVisibilityProviderKey   String?  @default("") @map("ai_visibility_provider_key")
  crawlFrequency            String   @default("daily") @map("crawl_frequency")
  maxCrawlPages             Int      @default(60) @map("max_crawl_pages")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  createdAt                 DateTime @default(now()) @map("created_at")

  @@map("seo_project_configs")
}

model SeoAuditRun {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  domain               String
  status               String   @default("completed")
  source               String   @default("Hangbug SEO Crawler")
  overallScore         Int      @default(0) @map("overall_score")
  technicalScore       Int      @default(0) @map("technical_score")
  onPageScore          Int      @default(0) @map("on_page_score")
  contentScore         Int      @default(0) @map("content_score")
  indexingScore        Int      @default(0) @map("indexing_score")
  internalLinkingScore Int      @default(0) @map("internal_linking_score")
  scoreBreakdownJson   String   @default("{}") @map("score_breakdown_json")
  pagesScanned         Int      @default(0) @map("pages_scanned")
  criticalCount        Int      @default(0) @map("critical_count")
  warningCount         Int      @default(0) @map("warning_count")
  opportunityCount     Int      @default(0) @map("opportunity_count")
  passedCount          Int      @default(0) @map("passed_count")
  summaryJson          String   @default("{}") @map("summary_json")
  issuesJson           String   @default("[]") @map("issues_json")
  pagespeedJson        String?  @default("") @map("pagespeed_json")
  durationMs           Int      @default(0) @map("duration_ms")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([domain, createdAt])
  @@map("seo_audit_runs")
}

model SeoRecommendationState {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  domain      String
  recKey      String    @map("rec_key")
  title       String
  priority    String    @default("Medium")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedBy String?   @default("") @map("completed_by")
  completedAt DateTime? @map("completed_at")
  notes       String?   @default("")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([domain, recKey])
  @@index([domain, isCompleted])
  @@map("seo_recommendation_states")
}

model SeoCompetitor {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  domain           String
  competitorDomain String    @map("competitor_domain")
  label            String?   @default("")
  notes            String?   @default("")
  snapshotJson     String?   @default("{}") @map("snapshot_json")
  lastCheckedAt    DateTime? @map("last_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([domain, competitorDomain])
  @@index([domain])
  @@map("seo_competitors")
}

model SeoIntegrationSnapshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  domain    String
  provider  String
  dataJson  String   @default("{}") @map("data_json")
  source    String   @default("")
  syncedAt  DateTime @default(now()) @map("synced_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([domain, provider])
  @@index([domain, provider])
  @@map("seo_integration_snapshots")
}
