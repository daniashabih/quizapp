generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String       @unique
  password          String
  avatar            String?      @default("")
  role              String       @default("user")
  isVerified        Boolean      @default(false) @map("is_verified")
  resetToken        String?      @map("reset_token")
  resetTokenExpiry  DateTime?    @map("reset_token_expiry")
  passwordChangedAt DateTime?    @map("password_changed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime?    @updatedAt @map("updated_at")
  results           QuizResult[]
  gameScores        GameScore[]

  @@map("users")
}

model Question {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  category      String
  session       Int?     @default(1)
  questionText  String   @map("question_text")
  options       String
  correctAnswer String   @map("correct_answer")
  explanation   String?  @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("questions")
}

model QuizResult {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @map("user_id") @db.ObjectId
  category   String
  session    Int?     @default(1)
  score      Int
  total      Int
  percentage Float
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  isEnabled Boolean? @default(true) @map("is_enabled")

  @@map("categories")
}

model QuizAttempt {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String    @map("user_id")
  category             String
  session              Int?      @default(1)
  currentQuestionIndex Int       @default(0) @map("current_question_index")
  answers              String    @default("{}")
  flaggedQuestions     String    @default("[]") @map("flagged_questions")
  questionsSnapshot    String    @map("questions_snapshot")
  score                Int       @default(0)
  totalQuestions       Int       @default(0) @map("total_questions")
  answeredCount        Int       @default(0) @map("answered_count")
  progressPercentage   Float     @default(0) @map("progress_percentage")
  status               String    @default("in_progress")
  startedAt            DateTime  @default(now()) @map("started_at")
  lastSavedAt          DateTime  @default(now()) @map("last_saved_at")
  completedAt          DateTime? @map("completed_at")

  @@index([userId, status])
  @@index([userId, category, session, status])
  @@map("quiz_attempts")
}

model Setting {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  appName                 String   @default("HangBug") @map("app_name")
  passingScore            Int      @default(70) @map("passing_score")
  certificatePassingScore Int      @default(80) @map("certificate_passing_score")
  quizTimerEnabled        Boolean  @default(false) @map("quiz_timer_enabled")
  quizTimerSeconds        Int      @default(30) @map("quiz_timer_seconds")
  adsEnabled              Boolean  @default(true) @map("ads_enabled")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage      String   @default("HangBug is undergoing scheduled maintenance. We'll be back shortly!") @map("maintenance_message")
  certificateEnabled      Boolean  @default(true) @map("certificate_enabled")
  leaderboardEnabled      Boolean  @default(true) @map("leaderboard_enabled")
  primaryColor            String   @default("#193D35") @map("primary_color")
  secondaryColor          String   @default("#FFFFFF") @map("secondary_color")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Game {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  slug         String             @unique
  title        String
  description  String
  instructions String?            @default("")
  category     String             // "Coding Games" or "Typing Games"
  difficulty   String?            @default("All Levels")
  thumbnail    String?            @default("")
  badge        String?            @default("") // "Featured", "Hot", "New", "Popular"
  isPublished  Boolean            @default(true) @map("is_published")
  isFeatured   Boolean            @default(false) @map("is_featured")
  cardSize     String?            @default("medium") @map("card_size") // "large", "tall", "medium", "small"
  aspectRatio  String?            @default("16/9") @map("aspect_ratio")
  order        Int                @default(0)
  playsCount   Int                @default(0) @map("plays_count")
  rating       Float?             @default(4.9)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime?          @updatedAt @map("updated_at")
  scores       GameScore[]
  favorites    UserGameFavorite[]

  @@map("games")
}

model GameScore {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @map("user_id") @db.ObjectId
  gameId          String   @map("game_id") @db.ObjectId
  gameSlug        String   @map("game_slug")
  score           Int
  highScore       Int?     @default(0) @map("high_score")
  accuracy        Float?   @default(100.0)
  wpm             Float?   @default(0.0)
  difficulty      String?  @default("All Levels")
  isCompleted     Boolean? @default(true) @map("is_completed")
  durationSeconds Int?     @default(0) @map("duration_seconds")
  metadata        String?  @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameSlug])
  @@index([gameSlug, score])
  @@map("game_scores")
}

model UserGameProgress {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @map("user_id")
  gameSlug     String   @map("game_slug")
  highScore    Int      @default(0) @map("high_score")
  bestWpm      Float?   @default(0) @map("best_wpm")
  bestAccuracy Float?   @default(0) @map("best_accuracy")
  totalPlays   Int      @default(0) @map("total_plays")
  lastPlayedAt DateTime @default(now()) @map("last_played_at")

  @@unique([userId, gameSlug])
  @@map("user_game_progress")
}

model UserGameFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id")
  gameId    String   @map("game_id") @db.ObjectId
  gameSlug  String   @map("game_slug")
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameSlug])
  @@map("user_game_favorites")
}

model GameChallenge {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  gameSlug     String   @map("game_slug")
  title        String
  difficulty   String   @default("Beginner") // Beginner, Intermediate, Advanced
  language     String?  @default("javascript") // html, css, javascript, php, python, sql, general
  description  String?  @default("")
  content      String   // Code snippet, passage text, scrambled blocks, or puzzle spec (JSON or string)
  solution     String   // Expected answer, order, correct line, or expected SQL result (kept secure on backend)
  hints        String?  @default("")
  explanation  String?  @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([gameSlug, difficulty])
  @@map("game_challenges")
}
