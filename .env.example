# ==========================================
# Hangbug Core Configuration & Secrets
# ==========================================

# Database Connection (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/HangBug?retryWrites=true&w=majority"

# Authentication Secrets (JWT Signing)
JWT_SECRET="your_jwt_secret_key"

# Application Base URLs
# Production: https://hangbug.vercel.app
# Local Development: http://localhost:3000
APP_BASE_URL="https://hangbug.vercel.app"

# ==========================================
# Transactional Email Service (Password Reset)
# ==========================================
# Option A: Resend (Recommended for Vercel Serverless)
# Sign up at https://resend.com and obtain your API key starting with 're_'
RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_PROVIDER_API_KEY="re_your_resend_api_key"

# Sender address shown in delivered emails:
# - For testing without a custom domain in Resend: "Hangbug <onboarding@resend.dev>"
#   (Note: onboarding@resend.dev only delivers to the email address registered with your Resend account)
# - For production with a verified domain: "Hangbug <noreply@yourdomain.com>"
#   (Requires verifying MX/TXT/CNAME DNS records at https://resend.com/domains)
EMAIL_FROM_ADDRESS="Hangbug <onboarding@resend.dev>"

# Option B: Standard SMTP (SendGrid, Mailgun, Brevo, AWS SES, Gmail, etc.)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your_smtp_username"
# SMTP_PASS="your_smtp_password"
# SMTP_SECURE=false

# Option C: SendGrid Web API (Alternative)
# SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# ==========================================
# AI Generation Keys (Optional)
# ==========================================
OPENAI_API_KEY=
GEMINI_API_KEY=
