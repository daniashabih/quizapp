# ==========================================
# Hangbug Core Configuration & Secrets
# ==========================================

# Database Connection (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/HangBug?retryWrites=true&w=majority"

# Authentication Secrets (JWT Signing)
JWT_SECRET="your_jwt_secret_key"

# Application Base URLs
# Production: https://www.hangbug.com
# Local Development: http://localhost:3000
APP_BASE_URL="https://www.hangbug.com"

# ==========================================
# Transactional Email Service (Password Reset)
# ==========================================
# Option A: Resend (Recommended for Vercel Serverless)
# Sign up at https://resend.com and obtain your API key starting with 're_'
RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_PROVIDER_API_KEY="re_your_resend_api_key"

# Sender address shown in delivered emails:
# - For testing without a custom domain in Resend: "Hangbug <onboarding@resend.dev>"
#   (Note: onboarding@resend.dev only delivers to the email address registered with your Resend account)
# - For production with a verified domain: "Hangbug <noreply@yourdomain.com>"
#   (Requires verifying MX/TXT/CNAME DNS records at https://resend.com/domains)
EMAIL_FROM_ADDRESS="Hangbug <onboarding@resend.dev>"

# Option B: Standard SMTP (SendGrid, Mailgun, Brevo, AWS SES, Gmail, etc.)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your_smtp_username"
# SMTP_PASS="your_smtp_password"
# SMTP_SECURE=false

# Option C: SendGrid Web API (Alternative)
# SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
# Google OAuth 2.0 Web Client ID & Secret (used for Google Sign-In and Google Search Console OAuth 2.0):
# In Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client):
# - Authorized JavaScript origins MUST include:
#     https://www.hangbug.com
#     https://hangbug.com
#     http://localhost:5173
#     http://localhost:3000
# - Authorized redirect URIs MUST include the Google Search Console OAuth callback URL:
#     https://www.hangbug.com/api/admin/seo/gsc/oauth/callback
#     http://localhost:3000/api/admin/seo/gsc/oauth/callback
#     http://localhost:5173/api/admin/seo/gsc/oauth/callback
GOOGLE_CLIENT_ID="your_google_oauth_web_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_web_client_secret"
GOOGLE_REDIRECT_URI="https://www.hangbug.com/api/admin/seo/gsc/oauth/callback"
VITE_GOOGLE_CLIENT_ID="your_google_oauth_web_client_id.apps.googleusercontent.com"

# ==========================================
# AI Book-Based RAG Verification & Embeddings
# ==========================================
# Chat / Verification provider selection: "groq", "openai", or "gemini"
# (auto-detects whichever key is configured, preferring Groq for verification)
AI_PROVIDER="groq"

# Groq AI (Fast Chat Completions for Technical Question Verification & Generation)
# Base URL: https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OpenAI (text-embedding-3-small @ 1536 dims + optional fallback chat gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_VERIFICATION_MODEL="gpt-4o-mini"

# Google Gemini (optional gemini-embedding-001 @ 1536 dims + optional chat gemini-2.5-flash; NOT required for PDF OCR)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_VERIFICATION_MODEL="gemini-2.5-flash"

# Optional explicit embedding provider override ("openai" or "gemini") when AI_PROVIDER="groq"
EMBEDDING_PROVIDER=

# MongoDB Atlas Vector Search Configuration
MONGODB_VECTOR_INDEX="book_chunks_vector_index"
AI_EMBEDDING_DIMENSIONS=1536

# Book Upload, Free OCR, Cache, Timeouts & Rate Limit Guardrails
MAX_BOOK_FILE_SIZE_MB=50
# Free Open-Source Scanned PDF OCR (Built-in PDF.js + Canvas + Offline Tesseract.js LSTM — no paid API keys required!)
OCR_LANGUAGE="eng"
OCR_BATCH_PAGES=3
OCR_RENDER_SCALE=2.0
OCR_MAX_RENDER_DIM=2200
OCR_PAGE_TIMEOUT_MS=16000
# Optional: External self-hosted open-source OCR worker service (see ocr-worker/ for free Render/Fly/Railway Docker deployment)
# Leave blank to use the built-in Vercel-compatible PDF.js + Tesseract.js engine directly.
OCR_WORKER_URL=
OCR_WORKER_SECRET=
OCR_WORKER_TIMEOUT_MS=45000
OCR_WORKER_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_RETRIES=3
AI_CACHE_TTL_MS=1800000
AI_DAILY_REQUEST_LIMIT=0
AI_DAILY_TOKEN_LIMIT=0
AI_VERIFY_RATE_LIMIT_MAX=40
AI_ADMIN_TEST_RATE_LIMIT_MAX=30
VECTOR_SEARCH_MIN_SCORE=0.25

# ==========================================
# Hangbug SEO & Growth Integrations (Optional)
# ==========================================
# Google Search Console uses Google OAuth 2.0 (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI)
# Connect & select your verified property (e.g. sc-domain:hangbug.com or https://www.hangbug.com/) from SEO Dashboard -> Settings.
GSC_SITE_URL=
GA4_PROPERTY_ID=
# Optional encryption key for stored OAuth tokens in MongoDB (defaults to JWT_SECRET if omitted)
SEO_TOKEN_ENCRYPTION_KEY=

# Google PageSpeed Insights / Lighthouse API Key (Optional; increases quota)
GOOGLE_PAGESPEED_API_KEY=

# Optional Third-Party Backlink / Keyword Providers
OPENPAGERANK_API_KEY=
