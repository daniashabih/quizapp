# ==========================================
# Hangbug Core Configuration & Secrets
# ==========================================

# Database Connection (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/HangBug?retryWrites=true&w=majority"

# Authentication Secrets (JWT Signing)
JWT_SECRET="your_jwt_secret_key"

# Application Base URLs
# Production: https://www.hangbug.com
# Local Development: http://localhost:3000
APP_BASE_URL="https://www.hangbug.com"

# ==========================================
# Transactional Email Service (Password Reset)
# ==========================================
# Option A: Resend (Recommended for Vercel Serverless)
# Sign up at https://resend.com and obtain your API key starting with 're_'
RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_PROVIDER_API_KEY="re_your_resend_api_key"

# Sender address shown in delivered emails:
# - For testing without a custom domain in Resend: "Hangbug <onboarding@resend.dev>"
#   (Note: onboarding@resend.dev only delivers to the email address registered with your Resend account)
# - For production with a verified domain: "Hangbug <noreply@yourdomain.com>"
#   (Requires verifying MX/TXT/CNAME DNS records at https://resend.com/domains)
EMAIL_FROM_ADDRESS="Hangbug <onboarding@resend.dev>"

# Option B: Standard SMTP (SendGrid, Mailgun, Brevo, AWS SES, Gmail, etc.)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your_smtp_username"
# SMTP_PASS="your_smtp_password"
# SMTP_SECURE=false

# Option C: SendGrid Web API (Alternative)
# SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# ==========================================
# Google OAuth 2.0 Credentials
# ==========================================
# Google OAuth 2.0 Web Client ID:
# In Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client):
# - Authorized JavaScript origins MUST include:
#     https://www.hangbug.com
#     https://hangbug.com
#     http://localhost:5173
#     http://localhost:3000
# - Authorized redirect URIs:
#     https://www.hangbug.com
#     https://www.hangbug.com/
#     https://hangbug.com
#     https://hangbug.com/
#     http://localhost:5173
#     http://localhost:3000
GOOGLE_CLIENT_ID="540959878402-4c2pda5555glmat0ajj11filc43ueedk.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="540959878402-4c2pda5555glmat0ajj11filc43ueedk.apps.googleusercontent.com"

# ==========================================
# AI Inference & Book-Based RAG Verification
# ==========================================
# Active provider: "huggingface" (default when HF_TOKEN is set), "openai", or "gemini"
AI_PROVIDER="huggingface"

# Hugging Face Inference Providers (Primary — stored securely in Vercel env vars; NEVER expose in src/ or mobile/)
# Token requires "Make calls to Inference Providers" permission from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_BASE_URL="https://router.huggingface.co/v1"

# Checked Hugging Face Instruction Models (availability & pricing verified via router.huggingface.co/v1/models):
# Primary: Qwen/Qwen3-30B-A3B-Instruct-2507:cheapest ($0.09/1M input, $0.30/1M output, 262k ctx, JSON structured output)
# Checked Fallback: deepseek-ai/DeepSeek-V4-Flash:cheapest (8 live providers, DeepInfra $0.09/1M in, $0.18/1M out, 1M ctx)
HF_CHAT_MODEL="Qwen/Qwen3-30B-A3B-Instruct-2507:cheapest"
HF_FALLBACK_CHAT_MODEL="deepseek-ai/DeepSeek-V4-Flash:cheapest"

# Dedicated Hugging Face Embedding Model for Book Semantic Search:
# BAAI/bge-large-en-v1.5 (1024 dims; live on both hf-inference & deepinfra at $0.010/1M tokens)
# Alternatives: BAAI/bge-base-en-v1.5 (768 dims), Qwen/Qwen3-Embedding-0.6B (1024 dims via deepinfra)
HF_EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
HF_EMBEDDING_PROVIDER="auto"
HF_EMBEDDING_FALLBACK_PROVIDER="deepinfra"
HF_EMBEDDING_DIMENSIONS=1024

# Resilience, Timeouts, Caching & Usage Guardrails
HF_REQUEST_TIMEOUT_MS=25000
HF_MAX_RETRIES=3
HF_CACHE_TTL_MS=1800000
AI_DAILY_REQUEST_LIMIT=0
AI_DAILY_TOKEN_LIMIT=0
AI_VERIFY_RATE_LIMIT_MAX=40
AI_ADMIN_TEST_RATE_LIMIT_MAX=30
VECTOR_SEARCH_MIN_SCORE=0.25

# Optional Legacy / Alternative Providers
# OpenAI (text-embedding-3-small @ 1536 dims + gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_VERIFICATION_MODEL="gpt-4o-mini"

# Google Gemini (gemini-embedding-001 @ 1536 dims + gemini-2.5-flash + native PDF OCR)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_VERIFICATION_MODEL="gemini-2.5-flash"

# MongoDB Atlas Vector Search Configuration
# NOTE: Match AI_EMBEDDING_DIMENSIONS to your active embedding model (1024 for BAAI/bge-large-en-v1.5, 1536 for OpenAI/Gemini)
MONGODB_VECTOR_INDEX="book_chunks_vector_index"
AI_EMBEDDING_DIMENSIONS=1024

# Book Upload Guardrails
MAX_BOOK_FILE_SIZE_MB=50
